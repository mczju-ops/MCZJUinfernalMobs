<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.infernalmobs</groupId>
    <artifactId>MCZJUInfernalMob</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>InfernalMobs</name>
    <description>炒鸡怪 - 丰富原版怪物战斗的 Infernal 风格插件</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <itemcreator.groupId>com.github.tozero0</itemcreator.groupId>
        <itemcreator.artifactId>itemcreator-api</itemcreator.artifactId>
        <itemcreator.version>1.0.0</itemcreator.version>
        <infernalapi.version>1.3.1</infernalapi.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper 26.2 API，与运行服务器 paper-26.2.jar 对齐。 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.63-beta</version>
            <scope>provided</scope>
        </dependency>
        <!-- ItemCreator API：仅编译期依赖(provided)，运行时由 MCZJUItemCreator 插件通过 ServicesManager 提供。
             默认从 tozero0/itemcreator-api 拉取。mczju-ops 公开后可：mvn -Pitemcreator-mczju clean install -->
        <dependency>
            <groupId>${itemcreator.groupId}</groupId>
            <artifactId>${itemcreator.artifactId}</artifactId>
            <version>${itemcreator.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- InfernalMobs 对外 API：编译期依赖（独立项目 MCZJUInfernalMobs-API 发布到 JitPack），打包时 shade 进插件 jar。 -->
        <dependency>
            <groupId>com.github.mczju-ops</groupId>
            <artifactId>MCZJUInfernalMobs-API</artifactId>
            <version>${infernalapi.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>itemcreator-mczju</id>
            <properties>
                <itemcreator.groupId>com.github.mczju-ops</itemcreator.groupId>
                <itemcreator.artifactId>MCZJUItemCreator</itemcreator.artifactId>
                <itemcreator.version>master-SNAPSHOT</itemcreator.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                    <!-- JDK 25 下 plexus-compiler 进程内编译(javax.tools)会抛 ConcurrentModificationException；
                         改用 fork 出进程 javac 编译以规避（见 JavaxToolsCompiler.compileInProcess 已知问题）。 -->
                    <fork>true</fork>
                </configuration>
            </plugin>
            <!-- 将对外 API（MCZJUInfernalMobs-API 中的 com.infernalmobs.api.** 与 SkillType）shade 进插件 jar，
                 使插件本体在运行时提供这些类，外部插件 softdepend 本插件即可访问。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.github.mczju-ops:MCZJUInfernalMobs-API</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
